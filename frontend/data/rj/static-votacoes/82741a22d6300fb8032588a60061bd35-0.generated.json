{"id":"82741a22d6300fb8032588a60061bd35:0","data":"2022-08-23","hora":"04:50 PM","sessao":{"tipo":"Sessão Ordinária","numero":"64ª Sessão","fase":"Ordem do Dia"},"proposicao":{"id":"PL-1069-A/2014","tipo":"PL","numero":"1069-A","ano":2014,"ementa":"DISPÕE SOBRE A PROIBIÇÃO DA RETENÇÃO DE MACAS DAS AMBULÂNCIAS DO SERVIÇO DE ATENDIMENTO MÓVEL DE URGÊNCIA – SAMU E DE OUTRAS UNIDADES MÓVEIS DE URGÊNCIA, PELAS UNIDADES DE SAÚDE DO MUNICÍPIO DO RIO DE JANEIRO, E DÁ OUTRAS PROVIDÊNCIAS","autores":["ALEXANDRE ISQUIERDO"],"autores_ids":["cvd:287"]},"objeto":"emenda","resultado":"sem_quorum","resultado_frase":"O SR. PRESIDENTE (CARLO CAIADO) – Presentes 20 (vinte) senhores vereadores. Não há quórum para deliberear sobre a matéria que voltará em votação. Tendo sido constatada a terceira falta de quórum para deliberar, a Presidência, antes de encerrar, comunica que, não tendo sofrido emenda de redação, fica considerada aprovada, nos termos regimentais, a redação final do Projeto de Lei nº1065-A/2022, que segue a autógrafo; e convoca Sessão Ordinária para amanhã, quarta-feira, dia 24 de agosto, às 14 horas. A Ordem do Dia é a continuação da designada anteriormente.","contagem":{"sim":0,"nao":20,"abstencao":1,"presentes_votando":null},"lado_vencedor":"nao","por_partido":{"?":{"nao":1},"CIDADANIA , PSDB":{"nao":1},"DEM , PSDB , Sem Partido, PSD":{"nao":1},"DEM , Sem Partido, PSD":{"nao":1},"DEM , UNIÃO , PROGRESSISTAS":{"nao":1},"NOVO":{"abstencao":1},"PROGRESSISTAS":{"nao":2},"PSC , MDB":{"nao":1},"PSOL":{"nao":6},"PSOL , PT":{"nao":1},"PT":{"nao":3},"PTB , PRD , PV":{"nao":1},"REPUBLICANOS":{"nao":1}},"presidente":"cvd:231","roster_mes":"2022-08","votos":{"cvd:231":"nao","cvd:286":"nao","cvd:142":"nao","cvd:274":"nao","cvd:335":"nao","cvd:319":"nao","cvd:107":"nao","cvd:345":"nao","cvd:351":"nao","nome:matheus-floriano":"nao","cvd:348":"nao","cvd:76":"nao","cvd:266":"nao","cvd:342":"nao","cvd:267":"nao","cvd:309":"nao","cvd:112":"nao","cvd:352":"nao","cvd:269":"nao","cvd:347":"n